{
  "name": "cyberfunk",
  "version": "2.0.0-alpha.0",
  "description": "CYBER FUNK: a Neon Orleans jazz-punk text RPG for the phone.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "build": "vite build",
    "build:server": "tsx server/build.ts",
    "start": "node --enable-source-maps dist-server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "tsx tools/depcruise.ts",
    "test": "vitest run --project game",
    "test:server": "vitest run --project server",
    "test:watch": "vitest --project game",
    "e2e": "playwright test",
    "sim": "tsx tools/sim.ts",
    "trace": "tsx tools/trace.ts",
    "check": "npm run typecheck && npm run lint && npm run depcruise && npm test",
    "legacy:build": "node legacy/build.js",
    "legacy:sim": "node legacy/sim/sim.js",
    "legacy:test": "node legacy/test/smoke.js trumpet",
    "parity:coverage": "c8 --check-coverage --branches 95 --include legacy/src/05_engine.js --include legacy/src/01_data_core.js --include legacy/src/02_data_enemies.js --include legacy/src/03_data_items.js --reporter text --reporter text-summary tsx tools/parity/coverage.ts",
    "validate": "tsx tools/validate-content.ts",
    "docs:codemap": "tsx tools/codemap.ts",
    "parity:engine": "vitest run tools/parity/engine.test.ts tools/parity/sim.test.ts tools/parity/properties.test.ts",
    "parity:rules": "vitest run tools/parity/rules.test.ts",
    "parity:content": "vitest run tools/parity/content.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate-cli.ts",
    "docker:up": "docker compose up --build -d --wait",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f compose.dev.yaml up --build",
    "docker:check": "docker compose -f compose.dev.yaml run --rm tools",
    "docker:e2e": "docker compose -f compose.dev.yaml run --rm e2e"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fontsource/monoton": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "valtio": "2.3.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "c8": "12.0.0",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
