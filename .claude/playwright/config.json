{
  "browser": {
    "isolated": true,
    "launchOptions": { "headless": true },
    "contextOptions": {
      "viewport": { "width": 360, "height": 740 },
      "deviceScaleFactor": 2,
      "isMobile": true,
      "hasTouch": true,
      "serviceWorkers": "block"
    },
    "initPage": ["init-page.ts"]
  },
  "testIdAttribute": "data-testid",
  "outputDir": ".playwright-mcp",
  "console": { "level": "warning" }
}
