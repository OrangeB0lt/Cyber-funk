# Settings for `docker compose up` (compose.yaml). Copy to .env and edit; .env is not committed.
# The defaults are fine on your own machine. Anywhere else, set a real password
# (letters and digits only: it goes into a connection URL).

APP_PORT=8080
POSTGRES_USER=cyberfunk
POSTGRES_PASSWORD=cyberfunk
POSTGRES_DB=cyberfunk
LOG_LEVEL=info
# true behind a reverse proxy, so rate limits see the client's IP
TRUST_PROXY=false
