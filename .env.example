# Settings for `docker compose up` (compose.yaml). Copy to .env and edit; .env is not committed.
# The defaults are fine on your own machine. Anywhere else, set a real password
# (letters and digits only: it goes into a connection URL).

# Where players reach the game. localhost and IP addresses get certificates from Caddy's own CA
# (trust its root on a phone: docs/guides/docker.md); a real domain gets Let's Encrypt (then use
# HTTP_PORT=80 and HTTPS_PORT=443, with DNS pointing at this machine).
SITE_ADDRESS=localhost
HTTP_PORT=8080
HTTPS_PORT=8443

POSTGRES_USER=cyberfunk
POSTGRES_PASSWORD=cyberfunk
POSTGRES_DB=cyberfunk
LOG_LEVEL=info
# The app runs behind Caddy, so rate limits take the client's IP from X-Forwarded-For.
TRUST_PROXY=true

# Optional: Google sign-in in front of the whole site (docs/guides/docker.md#require-google-sign-in).
# Needs a real domain in SITE_ADDRESS (or localhost), and docker/oauth2-proxy/emails.txt.
# COMPOSE_FILE=compose.yaml:compose.auth.yaml
# OAUTH2_PROXY_CLIENT_ID=xxxx.apps.googleusercontent.com
# OAUTH2_PROXY_CLIENT_SECRET=
# Generate with: openssl rand -base64 32 | tr -- '+/' '-_'
# OAUTH2_PROXY_COOKIE_SECRET=
